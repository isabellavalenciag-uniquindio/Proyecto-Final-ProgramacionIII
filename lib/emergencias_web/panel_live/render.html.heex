<div class={["app-shell", @menu && "menu-open"]} id="nexo-app">
  <button :if={@menu} class="sidebar-backdrop" phx-click="menu" aria-label="Cerrar navegación"></button>
  <aside class="sidebar">
    <a href="/" class="brand"><.marca /><span>NEXO<span class="brand-period">.</span></span></a>
    <div class="workspace-label">
      <span class="workspace-dot"></span>Centro de coordinación<.icono nombre="chevron" />
    </div>
    <span class="nav-label">TU RED DE APOYO</span>
    <nav aria-label="Navegación principal">
      <.link
        :for={item <- @secciones}
        patch={ruta(item.id)}
        class={["nav-item", @seccion.id == item.id && "active"]}
        aria-current={if @seccion.id == item.id, do: "page"}
      >
        <.icono nombre={item.icono} /><span>{item.nombre}</span>
        <span
          :if={item.id == "necesidades" and @datos.resumen.necesidades.pendientes > 0}
          class="nav-count"
        >{@datos.resumen.necesidades.pendientes}</span>
        <span
          :if={item.id == "mensajes" and @datos.resumen.mensajes.pendientes > 0}
          class="nav-dot"
        ></span>
      </.link>
    </nav>
    <div class="sidebar-bottom">
      <div class="sidebar-note">
        <span class="note-symbol">✳</span><h3>La unión hace la red.</h3><p>
          Cada reporte, cada recurso y cada persona cuentan.
        </p><span>NEXO · EMERGENCIAS</span>
      </div>
      <div class="user-profile">
        <span class="avatar">{Presentacion.iniciales(@usuario.nombre)}</span><div>
          <strong>{Presentacion.corto(@usuario.nombre, 20)}</strong><span>{Presentacion.etiqueta(
            @usuario.tipo
          )}</span>
        </div>
        <.form for={%{}} action="/salir" method="post">
          <button
            type="submit"
            class="icon-button logout-button"
            aria-label="Cerrar sesión"
            title="Cerrar sesión"
          ><.icono nombre="logout" /></button>
        </.form>
      </div>
    </div>
  </aside>

  <div class="main-area">
    <header class="topbar">
      <div class="breadcrumb">
        <button class="icon-button mobile-menu" phx-click="menu" aria-label="Abrir navegación"><.icono nombre="menu" /></button><span>Centro de coordinación</span><.icono nombre="chevron" /><strong>{@seccion.nombre}</strong>
      </div>
      <div class="topbar-right">
        <span class="live-status"><span class="status-dot"></span><span class="connected-label">Red en línea</span><span class="disconnected-label">Reconectando…</span></span><span class="topbar-divider"></span><.icono nombre="clock" /><time
          id="hora-bogota"
          phx-hook="Clock"
          phx-update="ignore"
        >--:--</time><span class="timezone">COL</span>
      </div>
    </header>

    <main class="page-content">
      <section class="page-heading">
        <div>
          <span class="section-kicker">{if @seccion.id == "inicio",
            do: "JUNTOS HACEMOS MÁS",
            else: "CENTRO DE COORDINACIÓN"}</span>
          <h1>
            {if @seccion.id == "inicio", do: "El panorama, conectado.", else: @seccion.nombre}
          </h1><p>{@seccion.descripcion}</p>
        </div>
        <div class="heading-actions">
          <%= if @seccion.id == "inicio" do %>
            <button
              :if={permite?(@usuario, :register_need)}
              class="button button-primary"
              phx-click="abrir"
              phx-value-accion="register_need"
            ><.icono nombre="plus" />Solicitar ayuda</button>
          <% else %>
            <% disponibles = acciones(@seccion.id, @usuario) %>
            <button
              :if={disponibles != []}
              class="button button-primary"
              phx-click="abrir"
              phx-value-accion={hd(disponibles).id}
            ><.icono nombre="plus" />{hd(disponibles).titulo}</button>
            <details :if={length(disponibles) > 1} class="action-menu">
              <summary class="button button-secondary">Más acciones<span>⌄</span></summary>
              <div class="action-menu-list">
                <button
                  :for={accion <- tl(disponibles)}
                  phx-click="abrir"
                  phx-value-accion={accion.id}
                >{accion.titulo}<.icono nombre="arrow" /></button>
              </div>
            </details>
          <% end %>
        </div>
      </section>

      <%= if @seccion.id == "inicio" do %>
        <section class="welcome-banner">
          <div class="welcome-copy">
            <span class="eyebrow"><span class="status-dot"></span> COORDINACIÓN ACTIVA</span><h2>
              Una red. Muchas formas<br />de hacer la diferencia.
            </h2><p>
              Hola, {List.first(String.split(@usuario.nombre))}. Conectemos lo que hace falta<br class="desktop-break" />
              con quienes pueden ayudar.
            </p><.link patch="/panel/zonas" class="welcome-link">Explorar la red de atención<.icono nombre="arrow" /></.link>
          </div>
          <div class="welcome-art" aria-hidden="true">
            <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three">
            </div><div class="art-center"><.marca /></div><span class="art-node node-one"><.icono nombre="home" /></span><span class="art-node node-two"><.icono nombre="heart" /></span><span class="art-node node-three"><.icono nombre="users" /></span><span class="art-node node-four"><.icono nombre="box" /></span><span class="art-dot dot-one"></span><span class="art-dot dot-two"></span>
          </div>
          <span class="banner-corner">LA AYUDA NOS CONECTA ↗</span>
        </section>

        <section class="metrics-grid" aria-label="Resumen de la emergencia">
          <.metrica
            titulo="Personas registradas"
            valor={@datos.resumen.personas.total}
            icono="users"
            detalle={"#{@datos.resumen.personas.localizadas} localizadas"}
          />
          <.metrica
            titulo="Necesidades pendientes"
            valor={@datos.resumen.necesidades.pendientes}
            icono="heart"
            tono="amber"
            detalle={"#{Enum.count(@datos.necesidades, &(&1.prioridad == :critica and &1.estado == :pendiente))} requieren atención crítica"}
          />
          <.metrica
            titulo="Cupos disponibles"
            valor={@datos.resumen.albergues.capacidad - @datos.resumen.albergues.ocupacion}
            icono="home"
            tono="blue"
            detalle={"En #{@datos.resumen.albergues.total} albergues de la red"}
          />
          <.metrica
            titulo="Zonas conectadas"
            valor={@datos.resumen.zonas}
            icono="map"
            tono="lime"
            detalle={"#{Presentacion.numero(afectados(@datos.zonas))} personas afectadas estimadas"}
          />
        </section>

        <div class="overview-grid">
          <section class="panel priority-panel">
            <div class="panel-heading">
              <div>
                <span class="panel-kicker">CADA MINUTO CUENTA</span><h2>Ayuda que hace falta</h2>
              </div><.link patch="/panel/necesidades" class="text-link">Ver todas<.icono nombre="arrow" /></.link>
            </div>
            <div :if={@datos.resumen.necesidades.pendientes > 0} class="priority-list">
              <article
                :for={
                  n <- Enum.take(Enum.filter(@datos.necesidades, &(&1.estado == :pendiente)), 4)
                }
                class="priority-row"
              >
                <span class={["priority-icon", "tone-" <> Presentacion.tono(n.prioridad)]}><.icono nombre={
                  if n.tipo == :refugio, do: "home", else: "heart"
                } /></span>
                <div class="priority-info">
                  <strong>{Presentacion.etiqueta(n.tipo)}<.insignia valor={n.prioridad} /></strong><p>
                    {n.id} · {n.zona}<span> · </span>{Presentacion.corto(n.descripcion, 35)}
                  </p>
                </div>
                <div class="priority-quantity">
                  <strong>{Necesidad.faltante(n)}</strong><span>por cubrir</span>
                </div>
                <button
                  :if={permite?(@usuario, :assign_resource)}
                  class="icon-button"
                  title="Asignar recursos"
                  aria-label={"Asignar recursos a #{n.id}"}
                  phx-click="abrir"
                  phx-value-accion="assign_resource"
                  phx-value-necesidad={n.id}
                ><.icono nombre="arrow" /></button>
              </article>
            </div>
            <.vacio
              :if={@datos.resumen.necesidades.pendientes == 0}
              titulo="Un buen lugar para empezar"
              descripcion="Las solicitudes de ayuda aparecerán aquí, ordenadas por prioridad."
              icono="heart"
            >
              <button
                :if={permite?(@usuario, :register_need)}
                class="button button-secondary button-small"
                phx-click="abrir"
                phx-value-accion="register_need"
              >Registrar la primera necesidad<.icono nombre="plus" /></button>
            </.vacio>
            <div class="panel-footnote">
              <span class="tiny-dot amber"></span>Las necesidades críticas aparecen primero.
            </div>
          </section>
          <section class="panel network-panel">
            <div class="panel-heading">
              <div>
                <span class="panel-kicker">EL TERRITORIO NOS UNE</span><h2>Red de atención</h2>
              </div><span class="count-chip">{length(@datos.zonas)} zonas</span>
            </div>
            <div class="network-map" aria-label="Vista esquemática de la red de zonas">
              <svg viewBox="0 0 400 230" fill="none" aria-hidden="true">
                <path
                  d="M0 55h400M0 115h400M0 175h400M65 0v230M135 0v230M205 0v230M275 0v230M345 0v230"
                  stroke="#dce6df"
                  stroke-width=".8"
                />
                <path
                  d="m-20 195 95-65 40 12 77-97 45 54 70-25 103 84"
                  stroke="#e3ebe3"
                  stroke-width="22"
                  stroke-linejoin="round"
                />
                <path
                  d="m-20 195 95-65 40 12 77-97 45 54 70-25 103 84"
                  stroke="#f5f8f2"
                  stroke-width="17"
                  stroke-linejoin="round"
                />
                <path
                  d="m-10 30 95 25 55-15 50 95 90 38 130-20"
                  stroke="#d4e4e0"
                  stroke-width="9"
                  stroke-linejoin="round"
                />
                <%= for {zona, i} <- Enum.with_index(Enum.take(@datos.zonas, 5)) do %>
                  <% {x, y} =
                    Enum.at([{90, 70}, {210, 115}, {310, 65}, {120, 175}, {290, 180}], i) %>
                  <path d={"M200 115 L#{x} #{y}"} stroke="#7a9c83" stroke-dasharray="3 5" />
                  <circle
                    cx={x}
                    cy={y}
                    r="16"
                    fill={if zona.nivel == :critico, do: "#fae4dc", else: "#dceacb"}
                  />
                  <circle
                    cx={x}
                    cy={y}
                    r="6"
                    fill={if zona.nivel == :critico, do: "#c96f54", else: "#557b55"}
                  />
                  <text x={x} y={y + 30} text-anchor="middle" fill="#43594d" font-size="10">
                    {Presentacion.corto(zona.nombre, 18)}
                  </text>
                <% end %>
                <g :if={@datos.zonas == []}>
                  <circle cx="200" cy="115" r="30" fill="#e2ebda" /><path
                    d="M190 115h20m-10-10v20"
                    stroke="#628060"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </g>
              </svg>
              <span class="map-caption">Vista esquemática · sin geolocalización</span>
            </div>
            <div class="network-summary">
              <span><span class="tiny-dot green"></span>{length(@datos.albergues)} albergues</span><span>{Enum.reduce(
                @datos.zonas,
                0,
                &(length(&1.hijos) + &2)
              )} sectores conectados</span>
            </div>
          </section>
        </div>

        <div class="overview-bottom">
          <section class="panel">
            <div class="panel-heading">
              <div>
                <span class="panel-kicker">UN LUGAR SEGURO</span><h2>Albergues de la red</h2>
              </div><.link patch="/panel/albergues" class="text-link">Explorar<.icono nombre="arrow" /></.link>
            </div>
            <div :if={@datos.albergues != []} class="shelter-mini-list">
              <div
                :for={a <- Enum.take(Enum.sort_by(@datos.albergues, & &1.porcentaje, :desc), 3)}
                class="shelter-mini"
              >
                <span class="shelter-mini-icon"><.icono nombre="home" /></span><div>
                  <strong>{a.nombre}</strong><span>{a.zona} · {a.cupos} cupos libres</span>
                </div><div class="mini-occupancy">
                  <strong>{round(a.porcentaje)}%</strong><div class="progress">
                    <span style={"width: #{a.porcentaje}%"}></span>
                  </div>
                </div>
              </div>
            </div>
            <.vacio
              :if={@datos.albergues == []}
              titulo="La red está por crecer"
              descripcion="Registra albergues para coordinar los espacios disponibles."
              icono="home"
            />
          </section>
          <section class="connection-card">
            <span class="connection-icon"><.icono nombre="message" /></span><span class="panel-kicker">UNA NOTICIA PUEDE CAMBIARLO TODO</span><h2>
              Estar cerca,<br />incluso a distancia.
            </h2><p>
              <strong>{@datos.resumen.mensajes.pendientes} mensajes</strong>
              esperan llegar a sus destinatarios.
            </p><.link patch="/panel/mensajes" class="button button-secondary">Abrir mensajes<.icono nombre="arrow" /></.link>
          </section>
        </div>
      <% else %>
        <%= if @seccion.id != "actividad" do %>
          <.form for={%{}} as={:filtros} phx-change="filtrar" id="filtros" class="filter-bar">
            <label class="search-box"><.icono nombre="search" /><span class="sr-only">Buscar registros</span><input
              name="filtros[consulta]"
              value={@consulta}
              placeholder="Buscar por nombre, código o estado…"
              phx-debounce="250"
            /></label>
            <div class="filter-right">
              <.icono nombre="map" /><label for="filtro-zona" class="sr-only">Filtrar por zona</label><select
                id="filtro-zona"
                name="filtros[zona]"
              ><option value="" selected={@zona == ""}>Todas las zonas</option><option
                :for={z <- @datos.zonas}
                value={z.codigo}
                selected={@zona == z.codigo}
              >
                {z.nombre}
              </option></select><button
                :if={@zona != "" or @consulta != ""}
                type="button"
                class="icon-button"
                phx-click="limpiar_filtros"
                title="Limpiar filtros"
                aria-label="Limpiar filtros"
              ><.icono nombre="close" /></button>
            </div>
          </.form>
        <% end %>
        <%= case @seccion.id do %>
          <% "zonas" -> %>
            <.zonas datos={@datos} usuario={@usuario} consulta={@consulta} zona={@zona} />
          <% "necesidades" -> %>
            <.necesidades datos={@datos} usuario={@usuario} consulta={@consulta} zona={@zona} />
          <% "recursos" -> %>
            <.recursos datos={@datos} usuario={@usuario} consulta={@consulta} zona={@zona} />
          <% "personas" -> %>
            <.personas datos={@datos} usuario={@usuario} consulta={@consulta} zona={@zona} />
          <% "mensajes" -> %>
            <.mensajes datos={@datos} usuario={@usuario} consulta={@consulta} zona={@zona} />
          <% "mascotas" -> %>
            <.mascotas
              datos={@datos}
              usuario={@usuario}
              consulta={@consulta}
              zona={@zona}
              coincidencias={@coincidencias}
            />
          <% "albergues" -> %>
            <.albergues datos={@datos} usuario={@usuario} consulta={@consulta} zona={@zona} />
          <% "actividad" -> %>
            <.actividad datos={@datos} usuario={@usuario} />
        <% end %>
      <% end %>
      <footer class="page-footer">
        <span><.marca />Conectar. Coordinar. Acompañar.</span><span><span class="tiny-dot green"></span>Datos compartidos · Actualizado a las {@actualizado}</span>
      </footer>
    </main>
  </div>

  <div
    :if={@aviso}
    class={["toast", @aviso.tipo == :error && "toast-error"]}
    role={if @aviso.tipo == :error, do: "alert", else: "status"}
    id="notificacion"
  >
    <span class="toast-icon"><.icono nombre={if @aviso.tipo == :error, do: "alert", else: "check"} /></span><p>
      {@aviso.texto}
    </p><button class="icon-button" phx-click="cerrar_aviso" aria-label="Cerrar notificación"><.icono nombre="close" /></button>
  </div>

  <div
    :if={@accion || @detalle}
    class="modal-backdrop"
    id="modal-fondo"
    phx-window-keydown="cerrar"
    phx-key="Escape"
  >
    <button class="modal-dismiss" phx-click="cerrar" aria-label="Cerrar ventana"></button>
    <section
      :if={@accion}
      class="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-titulo"
      id={"formulario-#{@accion.id}"}
      phx-hook="FocusFirst"
    >
      <div class="modal-heading">
        <span class="modal-symbol"><.icono nombre={@seccion.icono} /></span><button
          class="icon-button"
          phx-click="cerrar"
          aria-label="Cerrar formulario"
        ><.icono nombre="close" /></button>
      </div>
      <span class="section-kicker">UNA ACCIÓN QUE CONECTA</span><h2 id="modal-titulo">
        {@accion.titulo}
      </h2><p class="modal-description">{@accion.descripcion}</p>
      <.form
        for={%{}}
        as={:operacion}
        phx-submit="guardar"
        phx-change="validar"
        id="form-operacion"
      >
        <div class="form-grid">
          <.campo
            :for={campo <- @accion.campos}
            campo={campo}
            valores={@valores}
            datos={@datos}
            errores={@errores}
          />
        </div>
        <div :if={@accion.id == "cancel_need"} class="form-warning">
          <.icono nombre="alert" />Esta acción cerrará la solicitud seleccionada.
        </div>
        <div :if={@accion.campos == []} class="form-info">
          <.icono nombre="spark" />Buscaremos posibles coincidencias entre los reportes abiertos de toda la red.
        </div>
        <div class="modal-footer">
          <button class="button button-secondary" type="button" phx-click="cerrar">Volver</button><button
            class="button button-primary"
            type="submit"
            phx-disable-with="Guardando…"
          >Confirmar<.icono nombre="arrow" /></button>
        </div>
      </.form>
    </section>
    <section
      :if={@detalle}
      class="modal detail-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="detalle-titulo"
      id="detalle-registro"
      phx-hook="FocusFirst"
    >
      <div class="modal-heading">
        <span class="modal-symbol"><.icono nombre="clock" /></span><button
          class="icon-button"
          phx-click="cerrar"
          aria-label="Cerrar historial"
        ><.icono nombre="close" /></button>
      </div>
      <span class="section-kicker">CADA CAMBIO CUENTA</span><h2 id="detalle-titulo">
        Historial de {@detalle.registro.nombre}
      </h2>
      <p class="modal-description">Un recorrido por sus actualizaciones.</p>
      <div :if={@detalle.tipo == :persona} class="timeline">
        <div :for={{estado, fecha} <- @detalle.registro.historial} class="timeline-item">
          <span class="timeline-dot"></span><div>
            <.insignia valor={estado} /><time>{String.replace(fecha, "T", " · ")}</time>
          </div>
        </div>
      </div>
      <div :if={@detalle.tipo == :recurso} class="timeline">
        <div :for={{tipo, cantidad, fecha} <- @detalle.registro.movimientos} class="timeline-item">
          <span class="timeline-dot"></span><div>
            <strong>{Presentacion.etiqueta(tipo)}<span class="movement-amount">{cantidad} {@detalle.registro.unidad}</span></strong><time>{fecha}</time>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
