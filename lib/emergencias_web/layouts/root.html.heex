<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#132b29" />
    <meta
      name="description"
      content="NEXO — Centro de coordinación y gestión de emergencias."
    />
    <.live_title default="NEXO · Centro de coordinación" suffix=" · NEXO">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/assets/app.css" phx-track-static />
    <script defer src="/assets/vendor/app.js" phx-track-static>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
